# ==============================================================================
# Inventra — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: NEVER commit .env.local, .env, or any real secret keys to source control.
# ==============================================================================

# Application Metadata
NEXT_PUBLIC_APP_NAME="Inventra"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Configuration (Exposed to browser via NEXT_PUBLIC_)
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# Supabase Privileged Configuration (SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_)
# Bypasses Row-Level Security (RLS). Used exclusively for server-side seeding,
# demo resets, and background administrative maintenance.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"
